# Documentation template only; .env files are not automatically parsed.
# Actual environment variables override ignored app/config.local.php values.
# The /BrainLoop mount path is detected from index.php; no base URL setting is required.
BRAINLOOP_ENV=production
BRAINLOOP_HTTPS=1
BRAINLOOP_DB_DRIVER=mysql
BRAINLOOP_DB_HOST=127.0.0.1
BRAINLOOP_DB_PORT=3306
BRAINLOOP_DB_NAME=brainloop
BRAINLOOP_DB_USER=brainloop
# Supply the actual password privately; do not commit it.
BRAINLOOP_DB_PASSWORD=
# Optional SQLite backend: explicitly set BRAINLOOP_DB_DRIVER=sqlite.
# Keep the SQLite file outside public/.
# BRAINLOOP_DB_PATH=C:/private/brainloop/brainloop.sqlite

